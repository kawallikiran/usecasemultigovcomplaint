# --- Officer login password (change it before anyone else uses the portal)
OFFICER_PASSWORD=officer@123

# Copy this file to ".env" in the same folder. Fill in only the services you want; leave the rest empty.
# The services themselves are defined in config/ai_providers.yaml. .env is ignored by git and by the Docker
# build, so keys are never committed or baked into the image. Use synthetic data only with cloud services.
# Model names change often: check each provider's current list. Use a model that accepts images for use case 5.

# --- Bundled local open model (start with start-local-ai.bat / ./start-local-ai.sh) - no key, nothing leaves the PC
# Alternatives: gemma3:12b (needs a strong PC), qwen2.5vl:7b, or a newer Gemma / Qwen-VL from the Ollama library
LOCAL_MODEL=gemma3:4b
# Only when running "streamlit run app.py" with Ollama installed directly on your PC:
# OLLAMA_URL=http://localhost:11434/v1

# --- OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=

# --- Groq (OpenAI-compatible)
GROQ_API_KEY=
GROQ_MODEL=

# --- OpenRouter (OpenAI-compatible, many open and closed models)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# --- Any other OpenAI-compatible service (see the "custom" block in config/ai_providers.yaml)
CUSTOM_AI_BASE_URL=
CUSTOM_AI_MODEL=
CUSTOM_AI_API_KEY=
CUSTOM_AI_JSON_MODE=true

# --- Optional: which service the command line uses for AI test sets (default: the first ready one)
# AIGP_AI_PROFILE=local-open-model

# --- Speech-to-text for voice complaints (optional; without it, officers listen and type them in)
# Uses OPENAI_API_KEY or GROQ_API_KEY above, or a local server with the same API:
# OPENAI_STT_MODEL=whisper-1
# GROQ_STT_MODEL=whisper-large-v3
# LOCAL_STT_URL=http://host.docker.internal:8000/v1
# LOCAL_STT_MODEL=

# --- Citizen notifications (optional; without these, messages are recorded in the outbox only)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMS_GATEWAY_URL=          # receives POST {"to": "<mobile>", "message": "<text>"}
# SMS_GATEWAY_TOKEN=
# WHATSAPP_GATEWAY_URL=
# WHATSAPP_GATEWAY_TOKEN=
