# Copy this file to ".env" (same folder as docker-compose.yml) and fill in ONE service.
# .env is ignored by git and by the Docker build, so your key is never committed or baked into the image.
# Use synthetic data only: the AI engine sends data to the service you choose.
# Model names change often: check your provider's current list. For use case 5 pick a model that accepts images.

# --- OpenAI (or any OpenAI-compatible API: set AI_BASE_URL for Groq, OpenRouter, Together, Azure-style gateways)
AI_PROVIDER=openai
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=

# --- Anthropic Claude (example model: claude-haiku-4-5-20251001)
# AI_PROVIDER=anthropic
# AI_MODEL=claude-haiku-4-5-20251001
# AI_API_KEY=

# --- Google Gemini
# AI_PROVIDER=gemini
# AI_MODEL=
# AI_API_KEY=

# --- Local model with Ollama on your own computer (no data leaves the machine, no key needed)
# AI_PROVIDER=openai
# AI_MODEL=llama3.2-vision
# AI_BASE_URL=http://host.docker.internal:11434/v1
